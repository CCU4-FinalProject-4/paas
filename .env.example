# Config template. Copy to .env.floci (local) or .env.aws (real AWS); those are not versioned.
# The only difference between environments is AWS_ENDPOINT_URL: set means Floci, empty means real AWS.

# Floci: http://localhost:4566 from the host. Real AWS: leave empty.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Floci accepts any credentials; on real AWS use a least-privilege IAM user.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

ITEMS_TABLE=paas-items
SESSIONS_TABLE=paas-sessions
